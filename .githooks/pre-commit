#!/usr/bin/env bash
#
# Pre-commit hook to enforce standards for iOS SwiftUI

echo "---------------------------------------"
echo "Running Pre-commit Checks (iOS SwiftUI)"
echo "---------------------------------------"

if [ -f "LegoStyleDemo.xcodeproj/project.pbxproj" ]; then
    echo "🍏 Running iOS compilation checks..."
    make build-ios > /dev/null || {
        echo "❌ Pre-commit failed: iOS Xcode build failed."
        echo "Please fix the failing Swift compilation errors and try committing again."
        exit 1 
    }
fi

echo "✅ All checks passed! Proceeding with commit."
exit 0
